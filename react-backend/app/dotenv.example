# react env
MYSQL_HOST=
MYSQL_PORT=
MYSQL_DATABASE=
DATABASE_URL=mysql://root@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DATABASE}
NEXT_PUBLIC_TAICOL_API_URL=https://api.taicol.tw/v2
# change NEXT_PUBLIC_DOMAIN to official domain when running in production mode
NEXT_PUBLIC_DOMAIN=http://127.0.0.1:4000
SECRET=
NEXTAUTH_SECRET=
NEXT_PUBLIC_PAGINATE_LIMIT=10
# 版本名錄發佈 API（/api/publish/release）的 token：與更新服務 .env 的 RELEASE_PUBLISH_TOKEN 相同（openssl rand -hex 32）
RELEASE_PUBLISH_TOKEN=